        "type": "object",
        "properties": {
          "city": {"type": "string", "description": "City name"}
        },
        "required": ["city"]
      }
    },
    {
      "name": "convert_currency",
      "description": "Convert an amount from one currency to another using current exchange rates.",
      "inputSchema": {
        "type": "object",
